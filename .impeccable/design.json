  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Gold rectangular button for every booking action.",
      "html": "<button class=\"ds-btn ds-btn-gold\">Umów konsultację</button>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 28px;border-radius:4px;font:600 16px/1.15 var(--font);border:1.5px solid transparent;cursor:pointer;transition:background-color .25s,color .25s,transform .25s var(--ease)}.ds-btn:focus-visible{outline:2px solid var(--gold-ink);outline-offset:3px}.ds-btn:active{transform:none}.ds-btn-gold{background:var(--gold);color:var(--ink);box-shadow:0 10px 24px -14px rgba(138,106,50,.9)}.ds-btn-gold:hover{background:var(--gold-hi);transform:translateY(-2px)}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Graphite pill inside the treatment panel.",
      "html": "<button class=\"ds-btn ds-btn-dark\">Umów konsultację w sprawie tego zabiegu</button>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 28px;border-radius:4px;font:600 16px/1.15 var(--font);border:1.5px solid transparent;cursor:pointer;transition:background-color .25s,color .25s,transform .25s var(--ease)}.ds-btn:focus-visible{outline:2px solid var(--gold-ink);outline-offset:3px}.ds-btn:active{transform:none}.ds-btn-dark{background:var(--ink);color:#fff}.ds-btn-dark:hover{background:#3a362f;transform:translateY(-2px)}"
    },
    {
      "name": "Line Button",
      "kind": "button",
      "refersTo": "button-line",
      "description": "Secondary outline pill; inverts on hover.",
      "html": "<button class=\"ds-btn ds-btn-line\">Zobacz cennik</button>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 28px;border-radius:4px;font:600 16px/1.15 var(--font);border:1.5px solid transparent;cursor:pointer;transition:background-color .25s,color .25s,transform .25s var(--ease)}.ds-btn:focus-visible{outline:2px solid var(--gold-ink);outline-offset:3px}.ds-btn:active{transform:none}.ds-btn-line{background:rgba(255,255,255,.7);color:var(--ink);border-color:var(--ink)}.ds-btn-line:hover{background:var(--ink);color:#fff}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field, gold border on focus.",
      "html": "<label class=\"ds-field\"><span>Telefon</span><input placeholder=\"600 100 200\"></label>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-field{display:block;font-family:var(--font)}.ds-field span{display:block;font-size:15px;font-weight:600;margin-bottom:8px;color:var(--ink)}.ds-field input{display:block;width:100%;box-sizing:border-box;min-height:54px;padding:13px 16px;font:400 16px/1.3 var(--font);color:var(--ink);background:var(--paper);border:1.5px solid var(--line);border-radius:12px;caret-color:var(--gold-ink);transition:border-color .2s,background-color .2s}.ds-field input::placeholder{color:#8b8478}.ds-field input:focus{outline:none;border-color:var(--gold);background:#fff}"
    },
    {
      "name": "Time Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Radio tiles for preferred time; graphite when selected.",
      "html": "<div class=\"ds-chips\"><label><input type=\"radio\" name=\"p\" checked><span>Rano<small>8–12</small></span></label><label><input type=\"radio\" name=\"p\"><span>Wieczorem<small>16–20</small></span></label></div>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-chips{display:grid;grid-template-columns:repeat(2,140px);gap:8px;font-family:var(--font)}.ds-chips label{position:relative}.ds-chips input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}.ds-chips span{display:grid;gap:2px;text-align:center;padding:12px 6px;border:1.5px solid var(--line);border-radius:12px;background:var(--paper);font-weight:600;color:var(--ink);transition:border-color .2s,background-color .2s,color .2s}.ds-chips small{font-weight:400;font-size:13.5px;color:var(--ink-2)}.ds-chips label:hover span{border-color:var(--gold)}.ds-chips input:checked+span{background:var(--ink);border-color:var(--ink);color:#fff}.ds-chips input:checked+span small{color:var(--gold-hi)}.ds-chips input:focus-visible+span{outline:2px solid var(--gold-ink);outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "",
      "description": "Smile-curve wordmark, links with gold underline sweep, gold pill CTA.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-brand\" href=\"#\"><svg class=\"ds-smile\" viewBox=\"0 0 32 16\" aria-hidden=\"true\"><path d=\"M2 3c7 13 21 13 28 0\"/></svg><span>PORCELANA</span></a><a href=\"#\">Zabiegi</a><a href=\"#\">Cennik</a><a class=\"ds-cta\" href=\"#\">Umów konsultację</a></nav>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-nav{display:flex;align-items:center;gap:30px;font-family:var(--font);background:#fff;padding:14px 20px}.ds-brand{display:inline-flex;align-items:center;gap:12px;margin-right:auto;color:var(--ink);text-decoration:none}.ds-brand span{font-size:19px;font-weight:600;letter-spacing:.28em}.ds-smile{width:30px;height:15px;fill:none;stroke:var(--gold);stroke-width:2.6;stroke-linecap:round}.ds-nav a:not(.ds-cta):not(.ds-brand){color:var(--ink);font-size:16px;font-weight:500;text-decoration:none;padding-block:6px;background:linear-gradient(var(--gold),var(--gold)) 0 100%/0 2px no-repeat;transition:background-size .35s var(--ease)}.ds-nav a:not(.ds-cta):not(.ds-brand):hover{background-size:100% 2px}.ds-cta{display:inline-flex;align-items:center;min-height:46px;padding:10px 22px;border-radius:999px;background:var(--gold);color:var(--ink);font-weight:600;font-size:15px;text-decoration:none}.ds-cta:hover{background:var(--gold-hi)}"
    },
    {
      "name": "Consultation Card",
      "kind": "card",
      "refersTo": "card",
      "description": "The one bordered card: price figure and ticked inclusions on stone.",
      "html": "<div class=\"ds-wrap\"><div class=\"ds-card\"><p class=\"ds-price\"><strong>250 zł</strong><span>w całości odliczane od kosztu leczenia</span></p><ul class=\"ds-ticks\"><li>skan 3D i zdjęcia</li><li>cyfrowy projekt uśmiechu</li></ul></div></div>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-wrap{background:var(--stone);padding:24px;font-family:var(--font);color:var(--ink)}.ds-card{background:#fff;border:1px solid var(--line);border-radius:21px;padding:26px 28px}.ds-price{margin:0;display:grid}.ds-price strong{font-size:42px;font-weight:500;letter-spacing:-.02em;line-height:1.1}.ds-price span{color:var(--gold-ink);font-weight:500}.ds-ticks{list-style:none;padding:18px 0 0;margin:18px 0 0;border-top:1px solid var(--line);display:grid;gap:10px}.ds-ticks li{display:flex;gap:12px;align-items:baseline}.ds-ticks li::before{content:\"\";width:14px;height:7px;border:solid var(--gold-ink);border-width:0 0 2px 2px;transform:rotate(-45deg) translateY(-3px);flex:none}"
    },
    {
      "name": "Treatment Picker",
      "kind": "custom",
      "refersTo": "treatment-item",
      "description": "Signature: treatment tabs beside a paper panel with ruled facts and price.",
      "html": "<div class=\"ds-zab\"><div class=\"ds-list\"><button class=\"is-on\">Licówki porcelanowe<small>od 2 400 zł</small></button><button>Wybielanie<small>1 200 zł</small></button></div><div class=\"ds-panel\"><h3>Licówki porcelanowe</h3><dl><div><dt>Czas leczenia</dt><dd>3–4 tygodnie</dd></div><div><dt>Cena</dt><dd>od 2 400 zł</dd></div></dl></div></div>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-zab{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px;font-family:var(--font);color:var(--ink)}.ds-list{display:grid;gap:6px;align-content:start}.ds-list button{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:18px 20px;border:0;border-radius:14px;background:transparent;color:var(--ink);font:500 19px/1.3 var(--font);text-align:left;cursor:pointer;transition:background-color .25s}.ds-list small{font-size:14px;color:var(--ink-2);font-weight:400}.ds-list button:hover{background:var(--paper)}.ds-list button.is-on{background:var(--stone)}.ds-list button:focus-visible{outline:2px solid var(--gold-ink);outline-offset:3px}.ds-panel{background:var(--paper);border-radius:21px;padding:32px}.ds-panel h3{font-size:30px;font-weight:500;letter-spacing:-.02em;margin:0 0 14px}.ds-panel dl{margin:0;border-top:1px solid var(--line)}.ds-panel dl div{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)}.ds-panel dt{color:var(--ink-2)}.ds-panel dd{margin:0;font-weight:600;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Process Step",
      "kind": "custom",
      "refersTo": "step-number",
      "description": "Numbered circle on a gold connector line.",
      "html": "<ol class=\"ds-steps\"><li><span>1</span><h3>Konsultacja i skan 3D</h3></li><li><span>2</span><h3>Cyfrowy projekt uśmiechu</h3></li></ol>",
      "css": ":host{--white:#fff;--paper:#faf8f4;--stone:#efe9df;--gold:#c2a46c;--gold-hi:#d3b885;--gold-ink:#8a6a32;--gold-line:#d9c49b;--ink:#1f1d1a;--ink-2:#57524a;--line:#e7e0d4;--ease:cubic-bezier(.16,1,.3,1);--font:\"Albert Sans\",system-ui,sans-serif}.ds-steps{list-style:none;margin:0;padding:24px;display:grid;grid-template-columns:repeat(2,1fr);position:relative;background:var(--stone);font-family:var(--font);color:var(--ink)}.ds-steps::before{content:\"\";position:absolute;left:24px;right:24px;top:51px;height:1.5px;background:var(--gold-line)}.ds-steps li{position:relative;padding-right:28px}.ds-steps span{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#fff;border:1.5px solid var(--gold);font-size:22px;font-weight:600;color:var(--gold-ink);margin-bottom:26px;position:relative}.ds-steps h3{font-size:21px;font-weight:600;line-height:1.25;margin:0}"
    }
  ],
  "narrative": {
    "northStar": "The Porcelain Atelier",
    "overview": "A clinic that reads like a ceramist's studio, not a surgery with blue tiles. Warm white and pale stone carry almost every surface; champagne gold appears as one thin smile curve, the primary pill, the step rings, and once as a full-bleed field for patient voices. Graphite type sits on top in a single humanist sans at medium weight, sentence case, large. Depth comes from alternating grounds (white, stone, gold, graphite), not from boxes and shadows.\n\nThe page is light from the first pixel. The hero is a pale ground (hero-ground) with the patient portrait masked into it from the right, so photo and page are one surface. Sections alternate white and stone; content sits on full fields and hairline-ruled lists rather than tiled cards. Motion is quiet: a 2.2s settle on the hero image, 2px hover lifts on buttons, gold underline sweeps in the nav, and nothing that shifts layout.",
    "keyCharacteristics": [
      "Light, warm, low-contrast grounds with one gold accent family.",
      "Albert Sans 400–600 only, sentence case everywhere except the PORCELANA wordmark.",
      "Pill buttons, gently rounded surfaces (14px base), circular step rings.",
      "Hairline rules (1px line, 1.5px graphite top rule) structure lists, tables and FAQ.",
      "The gold smile curve is the only mark and the only ornament."
    ],
    "rules": [
      {
        "name": "The One Gold Rule",
        "body": "Gold is one family in three strengths: champagne fills, champagne-bright on dark and on hover, champagne-ink as text. No second accent hue; green and brick exist only as status.",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Gold Rule",
        "body": "Anything on a champagne fill is graphite, never white.",
        "section": "colors"
      },
      {
        "name": "The Gold Text Ground Rule",
        "body": "champagne-ink as body-size text sits on white or paper only; on stone it falls under 4.5:1.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "All text is sentence case. The tracked capitals of the PORCELANA wordmark are a logotype, not a style to reuse for labels.",
        "section": "typography"
      },
      {
        "name": "The Medium Ceiling Rule",
        "body": "Headings top out at 500, UI at 600. Weight 700 is loaded but never used.",
        "section": "typography"
      },
      {
        "name": "The Tabular Price Rule",
        "body": "Prices, hours and fact values use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Fields Not Cards Rule",
        "body": "Separate content with ground changes and hairlines. Only the form and the consultation card are bounded surfaces.",
        "section": "elevation & depth"
      },
      {
        "name": "The Smile Curve Rule",
        "body": "The only mark is one SVG path (`M2 3c7 13 21 13 28 0`, 32x16, round caps, 2.4–2.6 stroke) in champagne: beside the wordmark, as the testimonial mark (graphite on gold), and drawn in on form success.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do keep every surface on white, paper, stone, hero-ground, champagne or graphite.",
      "Do put graphite text on champagne, and use champagne-ink for gold text on white or paper.",
      "Do use pills for every button and 14/21px radii for surfaces.",
      "Do separate lists, prices and FAQ with 1px line hairlines under a 1.5px graphite top rule.",
      "Do match a hero ground to its photo's backdrop and mask the photo into it.",
      "Do keep motion to colour, 2px lifts and opacity; honour prefers-reduced-motion."
    ],
    "donts": [
      "Don't use uppercase labels, tracked caps or small headings above section titles; the only capitals are the wordmark.",
      "Don't add a second accent hue or blue clinical tones.",
      "Don't wrap sections in shadowed card grids; use fields and hairlines.",
      "Don't set headings heavier than 500 or use weight 700.",
      "Don't add icons or ornaments beyond the smile curve and the drawn tick."
    ]
  }
}